# ── Firebase Admin SDK (server-side only — set in Vercel dashboard) ──────────────
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account@project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── UniSync Smart Assistant (server-side only — set in Vercel dashboard) ────────
# Optional Gemini API key for Natural Language Understanding (intent extraction only)
# Zero timetable or private student data is ever sent to Gemini.
# If unset or quota exhausted, the assistant automatically uses deterministic logic.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
ENABLE_GEMINI_AI=true

# Persistent daily quota controls (enforced via atomic Firestore transactions)
ASSISTANT_USER_DAILY_LIMIT=3
ASSISTANT_GLOBAL_DAILY_LIMIT=300
