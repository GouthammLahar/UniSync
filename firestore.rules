rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // USERS
    // ==========================================
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ==========================================
    // GROUPS / SQUADS
    // ==========================================
    match /groups/{groupId} {

      // Reusable squad membership verification
      function isGroupMember() {
        return request.auth != null
          && exists(
            /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)
          );
      }

      function isGroupAdmin() {
        return request.auth != null
          && get(
            /databases/$(database)/documents/groups/$(groupId)
          ).data.adminUid == request.auth.uid;
      }

      allow read, create: if request.auth != null;

      allow update, delete: if isGroupAdmin();

      // ------------------------------------------
      // SQUAD MEMBERS
      // ------------------------------------------
      match /members/{memberUid} {

        allow read: if isGroupMember();

        allow create: if request.auth != null
                      && request.auth.uid == memberUid;

        allow update, delete: if request.auth != null
          && (
            request.auth.uid == memberUid
            || isGroupAdmin()
          );
      }

      // ------------------------------------------
      // SQUAD SCHEDULES
      // ------------------------------------------
      match /schedules/{scheduleUid} {

        allow read: if isGroupMember();

        allow write: if request.auth != null
          && request.auth.uid == scheduleUid
          && isGroupMember();
      }

      // ------------------------------------------
      // SQUAD CHAT MESSAGES
      // ------------------------------------------
      match /messages/{messageId} {

        // Only authenticated members can read messages
        allow read: if isGroupMember();

        // Only authenticated members can send valid messages
        allow create: if isGroupMember()

          // Sender must match authenticated Firebase UID
          && request.resource.data.senderId == request.auth.uid

          // Validate message content
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 1
          && request.resource.data.message.size() <= 500
          && request.resource.data.message.matches('.*\\S.*')

          // Validate sender name
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() >= 1
          && request.resource.data.senderName.size() <= 100

          // Validate server-generated timestamp
          && request.resource.data.createdAt == request.time

          // Prevent unexpected or additional fields
          && request.resource.data.keys().hasAll([
            'senderId',
            'senderName',
            'message',
            'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'senderId',
            'senderName',
            'message',
            'createdAt'
          ]);

        // Messages cannot be edited or deleted by clients
        allow update, delete: if false;
      }
    }

    // ==========================================
    // MEETINGS
    // ==========================================
    match /meetings/{meetingId} {

      function isParticipantOf() {
        return request.auth != null
          && request.auth.uid in resource.data.participants;
      }

      function isOrganizerOf() {
        return request.auth != null
          && resource.data.organizerUid == request.auth.uid;
      }

      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;

      // Participant: may update only responses + updatedAt
      // Organizer: may also update status, finalOptionIndex, confirmedAt,
      //            date, startTime, endTime, votingDeadline
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && (
          (
            // Participant updating their own response only
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['responses', 'updatedAt'])
          )
          ||
          (
            // Organizer may update broader set of fields
            resource.data.organizerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['responses', 'updatedAt', 'status', 'finalOptionIndex',
                           'confirmedAt', 'date', 'startTime', 'endTime', 'votingDeadline'])
            // For voting meetings, enforce lifecycle state transitions:
            && (
              // Classic meetings: unaffected
              !(resource.data.isVotingMeeting == true)
              ||
              // Voting meetings:
              (
                // Confirmed and cancelled are terminal:
                !(resource.data.status in ['confirmed', 'cancelled'])
                // Valid status transitions:
                && (
                  request.resource.data.status == resource.data.status
                  || (resource.data.status == 'voting_open'
                       && request.resource.data.status in ['voting_closed', 'confirmed', 'cancelled'])
                  || (resource.data.status == 'voting_closed'
                       && request.resource.data.status in ['confirmed', 'cancelled'])
                )
              )
            )
          )
        );

      allow delete: if false;

      // ── Voting subcollection ──────────────────────────────
      // Each participant writes only their own vote document (docId == uid)
      match /votes/{userId} {

        // Any participant of the parent meeting may read votes
        allow read: if request.auth != null
          && request.auth.uid in
               get(/databases/$(database)/documents/meetings/$(meetingId)).data.participants;

        // A participant can create or update only their own vote doc when
        // the meeting is open for voting and the deadline has not passed.
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          // Must be a participant
          && request.auth.uid in
               get(/databases/$(database)/documents/meetings/$(meetingId)).data.participants
          // Meeting must be in voting_open status
          && get(/databases/$(database)/documents/meetings/$(meetingId)).data.status == 'voting_open'
          // Deadline must be null or a Timestamp in the future.
          // Legacy/invalid non-timestamp values are rejected.
          && (
            get(/databases/$(database)/documents/meetings/$(meetingId)).data.votingDeadline == null
            || (
              get(/databases/$(database)/documents/meetings/$(meetingId)).data.votingDeadline is timestamp
              && request.time < get(/databases/$(database)/documents/meetings/$(meetingId)).data.votingDeadline
            )
          )
          // Payload validation
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.optionIndex is int
          && request.resource.data.optionIndex >= 0
          && request.resource.data.optionIndex < get(/databases/$(database)/documents/meetings/$(meetingId)).data.votingOptions.size()
          && request.resource.data.keys().hasOnly(['uid', 'optionIndex', 'votedAt', 'updatedAt']);

        allow delete: if false;
      }
    }

    // ==========================================
    // NOTIFICATIONS
    // ==========================================
    match /notifications/{notifId} {

      allow read: if request.auth != null
        && resource.data.recipientId == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['read']);

      allow create: if request.auth != null;

      allow delete: if false;
    }

    // ==========================================
    // FCM TOKENS
    // ==========================================
    match /fcmTokens/{tokenId} {

      allow read, write: if request.auth != null
        && (resource == null || resource.data.userId == request.auth.uid)
        && request.auth.uid == tokenId.split('_')[0];

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // ==========================================
    // ASSISTANT USAGE (Backend Admin SDK only)
    // ==========================================
    match /assistantUsage/{usageId} {
      allow read, write: if false;
    }
  }
}
