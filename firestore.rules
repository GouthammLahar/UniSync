rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // USERS COLLECTION (Private metadata like what groups they are in)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // GROUPS COLLECTION (Core isolation boundaries)
    match /groups/{groupId} {
      
      // Anyone logged in can create a group or read basic group info to verify an invite code
      allow read, create: if request.auth != null;
      
      // Only the group admin (creator) can rename, regenerate code, or delete the group
      allow update, delete: if request.auth != null && resource.data.adminUid == request.auth.uid;
      
      // SUBCOLLECTION: Members
      match /members/{memberUid} {
        // You can read the member list ONLY if you are currently a member of this specific group
        allow read: if request.auth != null && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        
        // You can join the group by writing your own UID document
        allow create: if request.auth != null && request.auth.uid == memberUid;
        
        // Members can leave, OR the Admin can kick them out
        allow update, delete: if request.auth != null && (
          request.auth.uid == memberUid || 
          get(/databases/$(database)/documents/groups/$(groupId)).data.adminUid == request.auth.uid
        );
      }
      
      // SUBCOLLECTION: Schedules
      match /schedules/{scheduleUid} {
        // You can only read schedules of people inside a group you are actively a member of!
        // This is the absolute core of the data privacy boundary.
        allow read: if request.auth != null && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        
        // You can only write your own schedule, AND you must be a member of the group
        allow write: if request.auth != null && 
                     request.auth.uid == scheduleUid && 
                     exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      }
      
    }

    // MEETINGS COLLECTION
    match /meetings/{meetingId} {
      // Only participants can read their meetings
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      
      // Participants can create meetings (organizer is validated client-side; use backend API for extra validation)
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      
      // Participants can update ONLY their own response field and updatedAt
      allow update: if request.auth != null 
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['responses', 'updatedAt', 'status']);
      
      // Only organizer can cancel (update status to 'cancelled')
      allow delete: if false; // soft-delete via status field only
    }

    // NOTIFICATIONS COLLECTION
    match /notifications/{notifId} {
      // Only the recipient can read and mark as read
      allow read: if request.auth != null && resource.data.recipientId == request.auth.uid;
      allow update: if request.auth != null 
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      
      // Create is allowed from client (for peer notifications without backend)
      allow create: if request.auth != null;
      allow delete: if false;
    }

    // FCM TOKENS COLLECTION
    match /fcmTokens/{tokenId} {
      allow read, write: if request.auth != null 
        && (resource == null || resource.data.userId == request.auth.uid)
        && request.auth.uid == tokenId.split('_')[0];
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid;
    }

    // ASSISTANT USAGE COLLECTION (Backend Admin SDK only — strictly protected)
    match /assistantUsage/{usageId} {
      allow read, write: if false;
    }
  }
}
