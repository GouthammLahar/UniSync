rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // USERS
    // ==========================================
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ==========================================
    // GROUPS / SQUADS
    // ==========================================
    match /groups/{groupId} {

      // Reusable squad membership verification
      function isGroupMember() {
        return request.auth != null
          && exists(
            /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)
          );
      }

      function isGroupAdmin() {
        return request.auth != null
          && get(
            /databases/$(database)/documents/groups/$(groupId)
          ).data.adminUid == request.auth.uid;
      }

      allow read, create: if request.auth != null;

      allow update, delete: if isGroupAdmin();

      // ------------------------------------------
      // SQUAD MEMBERS
      // ------------------------------------------
      match /members/{memberUid} {

        allow read: if isGroupMember();

        allow create: if request.auth != null
                      && request.auth.uid == memberUid;

        allow update, delete: if request.auth != null
          && (
            request.auth.uid == memberUid
            || isGroupAdmin()
          );
      }

      // ------------------------------------------
      // SQUAD SCHEDULES
      // ------------------------------------------
      match /schedules/{scheduleUid} {

        allow read: if isGroupMember();

        allow write: if request.auth != null
          && request.auth.uid == scheduleUid
          && isGroupMember();
      }

      // ------------------------------------------
      // SQUAD CHAT MESSAGES
      // ------------------------------------------
      match /messages/{messageId} {

        // Only authenticated members can read messages
        allow read: if isGroupMember();

        // Only authenticated members can send valid messages
        allow create: if isGroupMember()

          // Sender must match authenticated Firebase UID
          && request.resource.data.senderId == request.auth.uid

          // Validate message content
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 1
          && request.resource.data.message.size() <= 500
          && request.resource.data.message.matches('.*\\S.*')

          // Validate sender name
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() >= 1
          && request.resource.data.senderName.size() <= 100

          // Validate server-generated timestamp
          && request.resource.data.createdAt == request.time

          // Prevent unexpected or additional fields
          && request.resource.data.keys().hasAll([
            'senderId',
            'senderName',
            'message',
            'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'senderId',
            'senderName',
            'message',
            'createdAt'
          ]);

        // Messages cannot be edited or deleted by clients
        allow update, delete: if false;
      }
    }

    // ==========================================
    // MEETINGS
    // ==========================================
    match /meetings/{meetingId} {

      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;

      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['responses', 'updatedAt', 'status']);

      allow delete: if false;
    }

    // ==========================================
    // NOTIFICATIONS
    // ==========================================
    match /notifications/{notifId} {

      allow read: if request.auth != null
        && resource.data.recipientId == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['read']);

      allow create: if request.auth != null;

      allow delete: if false;
    }

    // ==========================================
    // FCM TOKENS
    // ==========================================
    match /fcmTokens/{tokenId} {

      allow read, write: if request.auth != null
        && (resource == null || resource.data.userId == request.auth.uid)
        && request.auth.uid == tokenId.split('_')[0];

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // ==========================================
    // GROUP CODE RESERVATIONS
    // ==========================================
    match /groupCodes/{codeId} {
      // Authenticated users can read individual code documents by ID.
      // This is required for:
      //   (a) availability checks  — client reads groupCodes/{CODE} to see if it exists
      //   (b) join-by-code flow    — client reads groupCodes/{CODE} to get the groupId
      //
      // Enumeration risk: Firestore rules cannot distinguish a point-read from a
      // collection-level query at the rule layer, but the client SDK will reject any
      // collection-level query (list) that is not explicitly allowed. Since we do NOT
      // grant `list` permission here — only `get` — a client can only read a document
      // if it already knows the exact code. That is not meaningful enumeration because
      // the user must already possess the code to look it up.
      //
      // The groupId field (a Firestore auto-ID) is revealed on a successful read.
      // This is acceptable: a user who knows the code should be able to find the group.
      allow get: if request.auth != null;

      // Explicitly deny collection-level listing — no authenticated user can enumerate
      // all codes. This rule is redundant (list is not granted above) but serves as
      // documentation and a defence-in-depth measure.
      allow list: if false;

      // Any authenticated user can claim an unclaimed code.
      // Firestore rejects this as an UPDATE (and rules deny updates) if the doc
      // already exists — making the first writer the permanent owner.
      allow create: if request.auth != null
        // Code ID must be valid: 4–12 uppercase alphanumeric characters
        && codeId.matches('^[A-Z0-9]{4,12}$')
        // Document must contain exactly the two required fields
        && request.resource.data.keys().hasAll(['groupId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['groupId', 'createdAt'])
        && request.resource.data.groupId is string
        && request.resource.data.groupId.size() > 0
        && request.resource.data.createdAt is string;

      // No client may update or delete a claimed code reservation.
      // Old codes are intentionally kept as tombstones so former members can still
      // join via an old code after regeneration. Admin cleanup via Firebase Console.
      allow update, delete: if false;
    }

    // ==========================================
    // ASSISTANT USAGE (Backend Admin SDK only)
    // ==========================================
    match /assistantUsage/{usageId} {
      allow read, write: if false;
    }

    // ==========================================
    // USER CREDENTIALS & INTEGRATIONS (Backend Admin SDK only)
    // Secure server-side OAuth tokens — never client readable/writable
    // ==========================================
    match /userCredentials/{userId} {
      allow read, write: if false;
    }

    // ==========================================
    // MEETING EMAILS (Backend Admin SDK only)
    // ==========================================
    match /meetingEmails/{emailId} {
      allow read, write: if false;
    }
  }
}
